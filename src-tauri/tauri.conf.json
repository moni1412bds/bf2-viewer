{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BF2 Visor",
  "version": "1.0.0",
  "identifier": "com.bf2.visor",
  "build": { "frontendDist": "../src" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "BF2 Visor 3D y 1P", "width": 1400, "height": 860, "minWidth": 900, "minHeight": 600, "dragDropEnabled": false }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": { "nsis": { "installMode": "currentUser", "languages": ["Spanish"] } },
    "fileAssociations": [
      { "ext": ["con", "tweak", "bundledmesh", "staticmesh", "skinnedmesh"], "name": "Archivo BF2", "description": "Archivo de Battlefield 2", "role": "Viewer" }
    ]
  }
}
